+/* PEAKS (after a pixel mountain scene Michael liked): a lit sky, dark ridges with snow catching the light, a sea of
+ * cloud below, dark dithered cloud banks above and a few birds (the cloud, the sea and the birds move: land_frame).
+ * The profiles here, from the scene's seed, are what the motion uses */
+static uint8_t pk_band[256], pk_puff[256], pk_sea[256];
+static int16_t pk_bird[4][2];
+static void lprofile(uint8_t *p, int32_t lo, int32_t hi, int32_t rough)
+{
+    int32_t v[257];
+    for (int32_t x = 0; x <= 256; x += 64) v[x] = lri(lo, hi);
+    v[256] = v[0];                                                /* (it wraps) */
+    for (int32_t step = 64; step > 1; step /= 2) {
+        int32_t half = step / 2, a = rough * step / 64 + 1;
+        for (int32_t x = half; x < 256; x += step) v[x] = (v[x - half] + v[x + half]) / 2 + lri(-a, a);
+    }
+    for (int32_t x = 0; x < 256; x++) p[x] = (uint8_t)(v[x] < 0 ? 0 : v[x] > 255 ? 255 : v[x]);
+}
