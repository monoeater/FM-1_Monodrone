+/* PEAKS' motion over the place */
+static void lpeaks_move(void)
+{
+    int32_t x, y, i;
+    uint32_t t = land_t;
+    /* the banks above: solid along the top, then a dithered body whose lower edge rolls past slowly */
+    int32_t ob = (int32_t)(t / 260u), op = (int32_t)(t / 130u);
+    for (x = 0; x < LW; x++) {
+        int32_t bot = 4 + pk_band[(x + ob) & 255] / 12;          /* 9..20 rows */
+        for (y = 0; y < bot; y++) {
+            int on = y < 3 ? 0 : y > bot - 3 ? ((x + y) & 1) && (y & 1) : ((x + y) & 1);
+            if (!on) lset(lw, x, y, 0);
+        }
+        /* puffs lower down: dithered clumps where the profile peaks, drifting a little faster */
+        int32_t pv = pk_puff[(x + op) & 255];
+        if (pv > 190) {
+            int32_t c = 26 + (int32_t)pk_band[(x * 3 + 40) & 255] / 20, hgt = (pv - 190) / 9;
+            for (y = c - hgt; y <= c + hgt; y++) if (!lget(lm, x, y) && ((x + y) & 1)) lset(lw, x, y, 0);
+        }
+    }
+    /* the sea of cloud: lit, its edge heaving slowly, a dithered shadow along the edge and under the rolls */
+    int32_t os = (int32_t)(t / 400u);
+    for (x = 0; x < LW; x++) {
+        int32_t e = 64 + ((int32_t)pk_sea[(x + os) & 255] - 128) / 6 + (int32_t)((pk_sea[(x * 2 + 77 - os) & 255]) >> 6);
+        for (y = e; y < LH; y++) lset(lw, x, y, 1);
+        for (y = e + 2; y < e + 4 && y < LH; y++) if ((x + y) & 1) lset(lw, x, y, 0);
+        int32_t e2 = e + 10 + ((int32_t)pk_sea[(x + 128 + os * 2) & 255] - 128) / 10;   /* a lower roll */
+        if (e2 < LH - 1 && ((x + e2) & 1)) lset(lw, x, e2, 0);
+    }
+    /* the birds: small dark marks gliding, wings up and down */
+    for (i = 0; i < 4; i++) {
+        int32_t bx = ((int32_t)pk_bird[i][0] + (int32_t)(t / (90u + (uint32_t)i * 25u))) % (LW + 20) - 10;
+        int32_t by = pk_bird[i][1] + (int32_t)((t / 500u + (uint32_t)i) % 3u) - 1;
+        int up = ((t / 180u) + (uint32_t)i) & 1u;
+        lset(lw, bx, by, 0);
+        lset(lw, bx - 1, by - up, 0); lset(lw, bx + 1, by - up, 0);
+        lset(lw, bx - 2, by - up, 0); lset(lw, bx + 2, by - up, 0);
+    }
+}
